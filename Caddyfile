{$SITE_DOMAIN} {
	tls {$ACME_EMAIL}
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	encode zstd gzip
	reverse_proxy app:3000
}

# Local testing without a public domain (example): use this block instead of the site above.
