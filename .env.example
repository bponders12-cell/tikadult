# Database connection (PostgreSQL; Prisma). Required for app features that use the DB.
# Prisma schema is configured for PostgreSQL (provider = "postgresql").
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth/session secret (Auth.js/NextAuth). Generate a strong random value.
NEXTAUTH_SECRET="replace-with-strong-random-secret"

# Public base URL for the app (working domain for now; final domain TBD).
NEXTAUTH_URL="https://tik.earnable.store"

# Optional: env-gated admin bootstrap for `prisma db seed` (no hardcoded secrets).
# Provide all three to upsert the initial admin user; leave unset to skip.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_HANDLE="admin"
# SEED_ADMIN_PASSWORD_HASH="<pre-hashed password/auth reference>"
