# ---------------------------------------------------------------------------
# Docker install / self-contained stack (.env.example) - placeholders only.
# Copy to .env and fill values before running ./install.sh (or install.ps1).
# Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Site / proxy (Caddy) ---
# Public domain served by Caddy (automatic Let's Encrypt TLS when DNS points here).
SITE_DOMAIN="tik.earnable.store"
# Email for ACME/Let's Encrypt certificate notices.
ACME_EMAIL="admin@example.com"
# HTTP Basic Auth gate credentials (demo is gated; site is 18+ with moderation deferred).
# BASIC_AUTH_HASH must be a bcrypt hash. Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
BASIC_AUTH_USER="demo"
BASIC_AUTH_HASH="$2a$14$REPLACE_WITH_BCRYPT_HASH_FROM_CADDY_HASH_PASSWORD"

# --- Postgres (internal container) ---
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-strong-db-password"
POSTGRES_DB="tik"
# App connection string (points at the postgres service inside the compose network).
DATABASE_URL="postgresql://postgres:replace-with-strong-db-password@postgres:5432/tik?schema=public"

# --- MinIO / S3-compatible object storage (internal container) ---
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="replace-with-strong-minio-password"
# S3 config consumed by the app (for demo, match MinIO root creds; region "auto" for MinIO).
S3_ENDPOINT="http://minio:9000"
S3_BUCKET="media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="replace-with-strong-minio-password"
S3_REGION="auto"
# Optional: override compose MinIO image tag if registry access differs in your environment.
# MINIO_IMAGE="minio/minio"

# --- Auth/session ---
# Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or: openssl rand -hex 32
NEXTAUTH_SECRET="replace-with-strong-random-secret-at-least-32-chars"
# Public base URL for the app; host should match SITE_DOMAIN in production.
NEXTAUTH_URL="https://tik.earnable.store"
# Optional alias used by auth helpers if set.
# AUTH_SECRET=""

# --- Payments (Plan 3) ---
# Provider name. Only "fake" (dev/test, no money moves) is implemented.
# In production, unset/"fake"/unknown disables payments (503) by design until a real adapter exists.
PAYMENT_PROVIDER="fake"
# Webhook signing secret (fake provider uses HMAC-SHA256 for x-fake-signature). Required in production.
PAYMENTS_WEBHOOK_SECRET="replace-with-strong-random-webhook-secret"

# --- Optional: env-gated admin bootstrap for `prisma db seed` (no hardcoded secrets) ---
# Provide all three to upsert the initial admin user on startup; leave unset to skip.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_HANDLE="admin"
# SEED_ADMIN_PASSWORD_HASH="<pre-hashed password/auth reference>"
