# Database connection (PostgreSQL; Prisma). Required for app features that use the DB.
# Prisma schema is configured for PostgreSQL (provider = "postgresql").
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth/session secret (Auth.js/NextAuth). Generate a strong random value.
NEXTAUTH_SECRET="replace-with-strong-random-secret"

# Public base URL for the app (working domain for now; final domain TBD).
NEXTAUTH_URL="https://tik.earnable.store"

# Payments (Plan 3). See docs/ops/payment-provider-eligibility.md and docs/ops/cost-and-deploy-notes.md.
# PAYMENT_PROVIDER: provider name. Only "fake" (dev/test, no money moves) is implemented.
#   Unset defaults to "fake" outside production. In production, unset, "fake", or an unknown name
#   disables payments (checkout and webhooks answer 503).
# PAYMENTS_WEBHOOK_SECRET: webhook signing secret (the fake provider's HMAC-SHA256 key for the
#   x-fake-signature header). Required in production; a fixed dev-only value is used when unset elsewhere.
# Payments in production also require DATABASE_URL (in-memory money records are not durable).
# PAYMENT_PROVIDER="fake"
# PAYMENTS_WEBHOOK_SECRET="replace-with-strong-random-secret"

# Optional: env-gated admin bootstrap for `prisma db seed` (no hardcoded secrets).
# Provide all three to upsert the initial admin user; leave unset to skip.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_HANDLE="admin"
# SEED_ADMIN_PASSWORD_HASH="<pre-hashed password/auth reference>"
