generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  viewer
  creator
  admin
  staff
}

enum FeedLayout {
  immersive
  side
}

enum MediaStatus {
  draft
  processing
  live
  flagged
  removed
}

enum MediaType {
  video
  image
}

enum MediaVisibility {
  public
  private
  restricted
}

enum ProcessingStatus {
  pending
  processing
  ready
  failed
}

enum MediaAssetKind {
  original
  web
  thumbnail
}

enum ReportStatus {
  open
  in_review
  resolved
  dismissed
}

enum EntitlementType {
  monthly
  yearly
  one_time
  per_video
}

enum EntitlementStatus {
  active
  expired
  revoked
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  handle         String    @unique
  passwordHash   String?
  authRef        String?
  role           Role      @default(viewer)
  ageConfirmedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  settings      UserSettings?
  profile       Profile?
  media         Media[]       @relation("UserMedia")
  reportsFiled  Report[]      @relation("ReportsFiled")
  reportsTarget Report[]      @relation("ReportsTarget")
  entitlements  Entitlement[]
  transactions  Transaction[]
}

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  media Media[]
}

model UserSettings {
  id             String     @id @default(cuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedLayout     FeedLayout @default(immersive)
  /// User-configurable privacy preferences (extensible). Defaults documented in src/lib/settings.ts and seed/docs.
  privacyPrefs   Json       @default("{}")
  /// User-configurable messaging preferences (extensible). Defaults documented in src/lib/settings.ts and seed/docs.
  messagingPrefs Json       @default("{}")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

/// Placeholder for future profile expansion (follow-on plans).
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  bio         String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Creator-uploaded video/image. `status` is the publish/flag lifecycle;
/// `processingStatus` tracks the checks/transcode pipeline.
model Media {
  id               String           @id @default(cuid())
  ownerId          String
  owner            User             @relation("UserMedia", fields: [ownerId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  title            String?
  type             MediaType        @default(video)
  visibility       MediaVisibility  @default(public)
  /// Null = free. Price in cents to unlock (per-video access).
  unlockPriceCents Int?
  status           MediaStatus      @default(draft)
  processingStatus ProcessingStatus @default(pending)
  processingError  String?
  flagReason       String?
  flaggedAt        DateTime?
  publishedAt      DateTime?
  durationSec      Int?
  /// Size of the original upload in bytes.
  sizeBytes        Int?
  /// MIME type / container format of the original (e.g. video/mp4).
  format           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  assets       MediaAsset[]
  entitlements Entitlement[]

  @@index([ownerId])
  @@index([status, visibility])
  @@index([categoryId, status])
}

/// A stored file for a Media: original upload, web-optimised variant, or thumbnail.
model MediaAsset {
  id          String         @id @default(cuid())
  mediaId     String
  media       Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  kind        MediaAssetKind
  /// Key within the StorageAdapter (see src/lib/media/storage.ts).
  storageKey  String
  contentType String
  sizeBytes   Int?
  width       Int?
  height      Int?
  createdAt   DateTime       @default(now())

  @@unique([mediaId, kind])
}

/// Placeholder for future moderation/reporting/flags (follow-on plans).
model Report {
  id           String       @id @default(cuid())
  reporterId   String?
  reporter     User?        @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?        @relation("ReportsTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  status       ReportStatus @default(open)
  reason       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

/// Placeholder for future paid access/entitlements (follow-on plans).
model Entitlement {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId   String?
  media     Media?            @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  type      EntitlementType   @default(one_time)
  status    EntitlementStatus @default(active)
  startsAt  DateTime          @default(now())
  endsAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  transaction Transaction?
}

/// Placeholder for future money flow/purchases/payouts (follow-on plans).
model Transaction {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlementId String?           @unique
  entitlement   Entitlement?      @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  amountCents   Int               @default(0)
  currency      String            @default("USD")
  status        TransactionStatus @default(pending)
  providerRef   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}
