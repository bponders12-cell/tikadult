generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  viewer
  creator
  admin
  staff
}

enum FeedLayout {
  immersive
  side
}

enum MediaStatus {
  draft
  processing
  live
  /// Currently unused: flagged-but-live items use status=live plus flagReason/flaggedAt.
  flagged
  removed
}

enum MediaType {
  video
  image
}

enum MediaVisibility {
  public
  private
  restricted
}

enum ProcessingStatus {
  pending
  processing
  ready
  failed
}

enum MediaAssetKind {
  original
  web
  thumbnail
}

enum ReportStatus {
  open
  in_review
  resolved
  dismissed
}

enum EntitlementType {
  monthly
  yearly
  one_time
  per_video
}

enum EntitlementStatus {
  active
  expired
  revoked
}

enum EntitlementScope {
  /// The creator's whole private collection (creatorId).
  creator
  /// A single media item (mediaId).
  media
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
  chargeback
}

enum PayoutStatus {
  unpaid
  paid
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  handle         String    @unique
  passwordHash   String?
  authRef        String?
  role           Role      @default(viewer)
  ageConfirmedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  settings      UserSettings?
  profile       Profile?
  media         Media[]       @relation("UserMedia")
  reportsFiled  Report[]      @relation("ReportsFiled")
  reportsTarget Report[]      @relation("ReportsTarget")
  entitlements  Entitlement[]       @relation("EntitlementBuyer")
  purchases     Transaction[]       @relation("TransactionBuyer")
  sales         Transaction[]       @relation("TransactionCreator")
  pricing       CreatorPricing?
}

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  media Media[]
}

model UserSettings {
  id             String     @id @default(cuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedLayout     FeedLayout @default(immersive)
  /// User-configurable privacy preferences (extensible). Defaults documented in src/lib/settings.ts and seed/docs.
  privacyPrefs   Json       @default("{}")
  /// User-configurable messaging preferences (extensible). Defaults documented in src/lib/settings.ts and seed/docs.
  messagingPrefs Json       @default("{}")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

/// Placeholder for future profile expansion (follow-on plans).
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  bio         String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Creator-uploaded video/image. `status` is the publish/flag lifecycle;
/// `processingStatus` tracks the checks/transcode pipeline.
model Media {
  id               String           @id @default(cuid())
  ownerId          String
  owner            User             @relation("UserMedia", fields: [ownerId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  title            String?
  type             MediaType        @default(video)
  visibility       MediaVisibility  @default(public)
  /// Null = free. Price in cents to unlock (per-video access).
  unlockPriceCents Int?
  status           MediaStatus      @default(draft)
  processingStatus ProcessingStatus @default(pending)
  processingError  String?
  flagReason       String?
  flaggedAt        DateTime?
  publishedAt      DateTime?
  durationSec      Int?
  /// Size of the original upload in bytes. BigInt so site-wide SUM() aggregates
  /// (quota checks) cannot overflow 32 bits; the records layer maps it to number.
  sizeBytes        BigInt?
  /// MIME type / container format of the original (e.g. video/mp4).
  format           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  assets       MediaAsset[]
  entitlements Entitlement[]
  transactions Transaction[]

  @@index([ownerId])
  @@index([status, visibility])
  @@index([categoryId, status])
}

/// A stored file for a Media: original upload, web-optimised variant, or thumbnail.
model MediaAsset {
  id          String         @id @default(cuid())
  mediaId     String
  media       Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  kind        MediaAssetKind
  /// Key within the StorageAdapter (see src/lib/media/storage.ts).
  storageKey  String
  contentType String
  sizeBytes   Int?
  width       Int?
  height      Int?
  createdAt   DateTime       @default(now())

  @@unique([mediaId, kind])
}

/// Placeholder for future moderation/reporting/flags (follow-on plans).
model Report {
  id           String       @id @default(cuid())
  reporterId   String?
  reporter     User?        @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?        @relation("ReportsTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  status       ReportStatus @default(open)
  reason       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

/// Paid access grant. scope=creator covers all of `creatorId`'s private collection;
/// scope=media covers one `mediaId`. Validity is evaluated at read time (src/lib/payments/entitlements.ts).
model Entitlement {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation("EntitlementBuyer", fields: [userId], references: [id], onDelete: Cascade)
  scope     EntitlementScope
  creatorId String?
  mediaId   String?
  media     Media?            @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  type      EntitlementType
  status    EntitlementStatus @default(active)
  startsAt  DateTime          @default(now())
  /// Null = never expires (one_time, per_video).
  endsAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  transaction Transaction?

  @@index([userId, scope])
  @@index([userId, creatorId])
  @@index([userId, mediaId])
}

/// One purchase attempt. Money columns are integer cents (BigInt; the records layer maps to number).
/// The split is snapshotted at creation and never recomputed.
model Transaction {
  id                   String            @id @default(cuid())
  buyerId              String?
  buyer                User?             @relation("TransactionBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  creatorId            String?
  creator              User?             @relation("TransactionCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  mediaId              String?
  media                Media?            @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  accessType           EntitlementType
  grossCents           BigInt
  platformFeeCents     BigInt
  creatorEarningsCents BigInt
  /// Creator share in basis points at the time the transaction was created.
  creatorShareBps      Int
  currency             String            @default("USD")
  status               TransactionStatus @default(pending)
  provider             String
  providerRef          String?
  entitlementId        String?           @unique
  entitlement          Entitlement?      @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  payoutStatus         PayoutStatus      @default(unpaid)
  paidOutAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([provider, providerRef])
  @@index([status])
  @@index([creatorId])
  @@index([buyerId])
}

/// Processed provider webhook deliveries (de-duplication).
model PaymentEvent {
  id            String   @id @default(cuid())
  provider      String
  eventId       String
  type          String
  transactionId String?
  receivedAt    DateTime @default(now())

  @@unique([provider, eventId])
}

/// A creator's collection prices in cents. Null = option not offered.
model CreatorPricing {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyPriceCents Int?
  yearlyPriceCents  Int?
  oneTimePriceCents Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Platform-wide key/value settings (e.g. creatorShareBps).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
